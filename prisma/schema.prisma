generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Track {
  id          Int      @id @default(autoincrement())
  artist      String?
  title       String?
  brand       String?
  trackId     String?
  url         String?
  purchaseUrl String?
  source      String   @default("Party Tyme")
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       String
  image       String
  affiliateUrl String
  category    String   @default("Karaoke Machines")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}